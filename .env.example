# Resend (https://resend.com) - powers the enquiry form at /api/booking.
# Copy to .env.local and fill in. Never commit real values.

# Sending-only API key, scoped to the verified domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where website enquiries are delivered.
RESEND_TO_EMAIL=contact@kingpinengineering.com.au

# Sender. The address must be on a domain verified in Resend.
RESEND_FROM_EMAIL=Kingpin Engineering Website <contact@kingpinengineering.com.au>
